# .env.example — SmartFace environment variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials

# ---------------------------------------------------------------------------
# Face-matching
# ---------------------------------------------------------------------------

# Euclidean distance threshold for accepting a face match (0.0 – 1.0).
# Lower = stricter.  Default: 0.45
TOLERANCE=0.45

# ---------------------------------------------------------------------------
# Attendance rules
# ---------------------------------------------------------------------------

# Time-in cutoff for 'present' vs 'late' status.  Format: HH:MM:SS (24-hr).
LATE_TIME=08:00:00

# ---------------------------------------------------------------------------
# Flask / session
# ---------------------------------------------------------------------------

# Long random secret used to sign session cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your-database-password-here
DB_NAME=smartface_db

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------

# Path (relative to project root) where enrollment JPEG samples are saved.
UPLOAD_DIR=uploads/face_samples

# ---------------------------------------------------------------------------
# Camera / image quality
# ---------------------------------------------------------------------------

# Mean pixel brightness (0–255) threshold for the low-light warning banner.
BRIGHTNESS_THRESHOLD=50
